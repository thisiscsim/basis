# Copy this file to `app/.env.local` (gitignored) and fill in your key.
# The Basis main process loads it at startup; spawned scripts inherit it.

# --- LLM (briefs, filing diffs, digests, chat, friction gate) ---
# Default provider is OpenAI with model gpt-5.5.
OPENAI_API_KEY=sk-your-rotated-key-here

# Optional escape hatch — rotate models/providers with no code change:
# BASIS_LLM_PROVIDER=openai            # openai | anthropic | openai-compatible
# BASIS_LLM_MODEL=gpt-5.5
# BASIS_LLM_BASE_URL=                  # e.g. http://localhost:11434/v1 for local models
# BASIS_LLM_API_KEY=                   # generic; overrides the provider-specific key
# ANTHROPIC_API_KEY=
# BASIS_REASONING_EFFORT=low           # low | medium | high

# --- SEC EDGAR (free, no key) ---
# EDGAR's fair-access policy asks for a contact email in the request
# User-Agent. Also settable in Settings -> Data Sources.
# BASIS_EDGAR_CONTACT=you@example.com
